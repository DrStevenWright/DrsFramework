{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1.0",
	"FriendlyName": "DRS XR Platform",
	"Description": "Platform layer: low-level XR integration and cross-platform device support.",
	"Category": "DRS",
	"CreatedBy": "Steven Wright",
	"CreatedByURL": "https://github.com/DrStevenWright/DrsFramework",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "DrsXrArbiter",
			"Type": "Runtime",
			"LoadingPhase": "EarliestPossible",
			"PlatformAllowList": [ "Win64", "Android" ]
		},
		{
			"Name": "DrsXrPlatform",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [ "Win64", "Android" ]
		},
		{
			"Name": "DrsXrHandTrackingMeta",
			"Type": "ClientOnly",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [ "Win64", "Android" ]
		},
		{
			"Name": "DrsXrMixedReality",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [ "Win64", "Android" ]
		},
		{
			"Name": "DrsXrPlatformEditor",
			"Type": "Editor",
			"LoadingPhase": "Default"
		},
		{
			"Name": "DrsXrPlatformTests",
			"Type": "DeveloperTool",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "DrsBase",
			"Enabled": true
		},
		{
			"Name": "DrsUtilities",
			"Enabled": true
		},
		{
			"Name": "XRBase",
			"Enabled": true
		},
		{
			"Name": "OpenXR",
			"Enabled": true
		},
		{
			"Name": "OpenXRHandTracking",
			"Enabled": true
		},
		{
			"Name": "AndroidDeviceProfileSelector",
			"Enabled": true
		},
		{
			"Name": "OculusXR",
			"Enabled": true
		}
	]
}
